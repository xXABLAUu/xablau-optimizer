{
  "name": "xablau-optimizer",
  "private": true,
  "version": "1.0.0",
  "description": "Xablau Optimizer — otimizador seguro e reversível para Windows 10 e 11. Criado por Xablau Studios (Luiz).",
  "author": "Xablau Studios (Luiz)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "versao": "node scripts/versao.mjs",
    "versao:conferir": "node scripts/versao.mjs --conferir",
    "binarios": "node scripts/preparar-binarios.mjs",
    "compilar": "node scripts/versao.mjs && node scripts/preparar-binarios.mjs --release && tauri build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "framer-motion": "12.43.0",
    "lucide-react": "0.577.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  },
  "engines": {
    "node": ">=20.19"
  }
}
